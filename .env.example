# ── Model provider ────────────────────────────────────────────────────────────
# Which implementation in sourcebook/rag/llm.py to use. Only "openai" ships today; add a
# subclass there to support a self-hosted model without touching other code.
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Optional model overrides — defaults are set in sourcebook/rag/llm.py
# OPENAI_ANSWER_MODEL=gpt-4o
# OPENAI_UTILITY_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Bound each OpenAI call. read timeout is idle time between streamed chunks.
# Defaults live in sourcebook/rag/config.py.
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=1
# OPENAI_STREAM_DEADLINE_SECONDS=90
# OPENAI_MAX_CONCURRENT_REQUESTS=20
# OPENAI_CAPACITY_WAIT_SECONDS=1

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=policy_assistant
# Connections held per process. Total cluster load is (workers x this) and must
# stay under the Atlas connection cap — see the arithmetic in sourcebook/rag/mongo.py.
# MONGO_MAX_POOL_SIZE=20

# ── Amazon S3 (raw policy documents) ──────────────────────────────────────────
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Application authentication ────────────────────────────────────────────────
# Generate the secret with: openssl rand -hex 32
JWT_SECRET_KEY=
# bcrypt hash of the shared password — see the README for how to generate it.
# Changing a hash signs out everyone who logged in with it; JWT_SECRET_KEY
# rotation is not required for that alone.
APP_PASSWORD_HASH=
# Optional: a second accepted password, hashed the same way. Leave unset for one.
# APP_PASSWORD_HASH_2=
# Optional: the Human Resources password, hashed the same way. Only a session
# opened with it can use the HR Requests queue and the What People Ask report;
# leave it unset and nobody can. Use a different password from the first. The
# same hash as APP_PASSWORD_HASH_2 makes the second password the HR one.
# It does not hide conversations, which every signed-in user can still list.
# HR_PASSWORD_HASH=

# ── Optional tuning (defaults live in sourcebook/rag/config.py) ─────────
# APP_NAME=Sourcebook
# Refuse to answer when the best passage scores below this. Raise to be stricter.
# SIMILARITY_THRESHOLD=0.62
# RETRIEVAL_K=5
# Bump when the coverage-judge prompt or parse contract changes; it is part of
# the answer-cache key.
# COVERAGE_PROMPT_VERSION=v2
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# Comma-separated origins allowed by CORS in local development.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Public address ────────────────────────────────────────────────────────────
# Hostname Caddy serves and obtains a Let's Encrypt certificate for. Leave unset
# for local `make compose`, which then serves plain HTTP on http://localhost.
# SITE_ADDRESS=sourcebook.duckdns.org

# ── Escalation ────────────────────────────────────────────────────────────────
# Who a refused or unhelpful answer is handed to. Shown in the UI.
# ESCALATION_CONTACT=Human Resources
# Optional JSON webhook that receives each escalation. The payload has a
# top-level "text" field, so a Slack or Teams incoming webhook works as-is.
# Leave empty to store escalations without sending them anywhere.
# ESCALATION_WEBHOOK_URL=
# ESCALATION_WEBHOOK_TIMEOUT_SECONDS=5
# Initial attempt plus authenticated retries before further retries are rejected.
# ESCALATION_WEBHOOK_MAX_ATTEMPTS=5
# Must be greater than ESCALATION_WEBHOOK_TIMEOUT_SECONDS.
# ESCALATION_WEBHOOK_LEASE_SECONDS=30

# ── Concurrency ───────────────────────────────────────────────────────────────
# Thread pool size, which caps chat streaming throughput. Measured curve and
# reproduction steps in docs/load-testing.md.
#   40 -> 15 req/s (anyio default) | 100 -> ~31 req/s (projected) | 320 -> 99 req/s
# THREADPOOL_TOKENS=100
# Separate pool for /api/auth/login so sign-in stays up when chat is saturated.
# LOGIN_THREADPOOL_TOKENS=10
# Per-address HTTP rate limits for model-backed and cache-busting routes.
# CHAT_RATE_LIMIT=30/minute
# REINDEX_RATE_LIMIT=2/minute

# ── Local development / load testing ──────────────────────────────────────────
# LLM_PROVIDER=fake runs the app with a deterministic offline model — no API key,
# no cost. It refuses to start when APP_ENV=production.
# FAKE_STREAM_DELAY_MS=20
# FAKE_UTILITY_DELAY_MS=300
# APP_ENV=production
