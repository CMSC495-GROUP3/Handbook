{
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "question": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "follow_ups": {
            "items": {
              "type": "string"
            },
            "title": "Follow Ups",
            "type": "array"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "refusal_reason": {
            "anyOf": [
              {
                "enum": [
                  "no_match",
                  "not_covered"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal Reason"
          },
          "refused": {
            "title": "Refused",
            "type": "boolean"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "sources",
          "confidence",
          "follow_ups",
          "refused",
          "session_id"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "CreateConversationRequest": {
        "properties": {
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "title": {
            "default": "New conversation",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "CreateConversationRequest",
        "type": "object"
      },
      "CreateEscalationRequest": {
        "description": "Names one assistant turn, by id where the client has one.\n\n`message_id` is the reliable name and wins when both are sent. Position is\nkept for conversations persisted before ids existed, whose stored messages\ncarry none; see #84 for why position alone cannot be trusted.",
        "properties": {
          "message_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "message_index": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Index"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "reason": {
            "enum": [
              "refused",
              "unhelpful"
            ],
            "title": "Reason",
            "type": "string"
          },
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "reason"
        ],
        "title": "CreateEscalationRequest",
        "type": "object"
      },
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RetryableError": {
        "description": "Body of a 503 from either chat route: the provider is at capacity.",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "retryable": {
            "const": true,
            "default": true,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "error"
        ],
        "title": "RetryableError",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UpdateConversationRequest": {
        "properties": {
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "UpdateConversationRequest",
        "type": "object"
      },
      "UpdateEscalationRequest": {
        "properties": {
          "resolution": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "UpdateEscalationRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Grounded question answering over internal policy documents.",
    "title": "Sourcebook API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/chat": {
      "post": {
        "description": "Non-streaming variant. Kept for testing and as a fallback; the UI uses\nthe streaming route.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryableError"
                }
              }
            },
            "description": "The model provider is at its concurrency limit. Retry after the number of seconds in the Retry-After header."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat"
      }
    },
    "/api/chat/stream": {
      "post": {
        "description": "SSE variant, the one the UI uses.\n\nThe generator's first event is produced here, before the response exists.\nEverything that can hit provider capacity before a token (the rewrite, the\nembeddings, opening the answer stream) runs inside that first next(), so a\nsaturated provider becomes an ordinary HTTP 503 with Retry-After, the same\ncontract as /chat, instead of a 200 whose stream opens and immediately\nends. The generator's finally still runs and stores nothing.",
        "operationId": "chat_stream_api_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryableError"
                }
              }
            },
            "description": "The model provider is at its concurrency limit. Retry after the number of seconds in the Retry-After header."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat Stream"
      }
    },
    "/api/config": {
      "get": {
        "description": "Non-secret configuration the frontend reads at startup.",
        "operationId": "config_api_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config"
      }
    },
    "/api/conversations": {
      "get": {
        "description": "List conversations; treat unresolved project ids as ungrouped.\n\nRead-side only: a stored project_id that no longer matches any project is\nreturned as null so the sidebar (and any other client that groups by\nexisting projects) still shows the conversation under ungrouped. Stored\nrows are not rewritten here. This remains useful for legacy or externally\nintroduced orphaned rows even when transactional writes are enabled.",
        "operationId": "list_conversations_api_conversations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Conversations"
      },
      "post": {
        "operationId": "create_conversation_api_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Conversation"
      }
    },
